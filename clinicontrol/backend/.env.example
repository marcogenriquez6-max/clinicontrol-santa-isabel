# ============================================================
# CliniControl — Variables de entorno del backend
# Copie este archivo a .env  ->  cp .env.example .env
# Los valores por defecto funcionan para una instalación local.
# ============================================================

NODE_ENV=development
PORT=3000

# Orígenes permitidos del frontend (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:4200

# --- Base de datos PostgreSQL ---
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=clinicontrol
DB_SYNC=false
DB_LOGGING=false
DB_POOL_SIZE=10

# --- Semilla de datos (solo en el primer arranque) ---
RUN_SEED=true
ADMIN_PASSWORD=Admin123!

# --- JWT (CAMBIE estos secretos en producción) ---
# Generar con: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_MFA_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis (opcional) ---
REDIS_HOST=localhost
REDIS_PORT=6379
