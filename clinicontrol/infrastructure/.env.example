# =============================================
# CLINICONTROL - Docker Environment Variables
# =============================================
# Copy this file to .env and customize:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env files to version control.
# Generate secrets with: openssl rand -hex 64
# =============================================

# PostgreSQL
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_DATABASE=hospital_db

# MinIO (object storage)
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=hospital-files

# JWT — Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Application
RUN_SEED=true
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4200
TAG=latest
PORT=3000
