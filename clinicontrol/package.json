{
  "name": "clinicontrol",
  "version": "1.0.0",
  "private": true,
  "description": "CLINICONTROL - Sistema de Gestión Hospitalaria",
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "backend": "npm run start:dev --workspace=backend",
    "backend:build": "npm run build --workspace=backend",
    "frontend": "npm run dev --workspace=frontend",
    "frontend:build": "npm run build --workspace=frontend",
    "frontend:preview": "npm run preview --workspace=frontend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "npm run backend:build && npm run frontend:build",
    "clean": "rm -rf backend/dist frontend/dist coverage"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
